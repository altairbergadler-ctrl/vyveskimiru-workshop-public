[Unit]
Description=Workshop mail attachment agent (fresh Codex session)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=workshop-mail
Group=workshop-mail
Environment=HOME=/var/lib/workshop-mail
Environment=CODEX_HOME=/var/lib/workshop-mail/.codex
Environment=PATH=/opt/node-v24.21.0-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/var/lib/workshop-mail/work
ExecStart=/usr/bin/python3 /opt/workshop-mail-runner/run-pass.py
TimeoutStartSec=75min
KillMode=control-group
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/workshop-mail
Nice=10

