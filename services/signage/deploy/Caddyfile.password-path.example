# Insert inside the existing site block. Keep all other site routes unchanged.
# Use ONLY with compose.password.yaml and a verified EDITOR_AUTH_FILE.
# Python protects all editor content; Caddy provides the existing site's HTTPS.
redir /signs /signs/ 308

handle_path /signs/* {
    request_body {
        max_size 30MB
    }
    reverse_proxy 127.0.0.1:18880 {
        header_up -Authorization
    }
}
