# Insert these directives INSIDE the existing vm-app.ru { ... } site block.
# Keep its existing routes and all other site blocks unchanged.
# Replace the placeholder with a bcrypt hash from `caddy hash-password`.
# This snippet requires Caddy 2.8+; older versions name basic_auth as basicauth.
# Validate the entire existing configuration before reloading Caddy.
redir /signs /signs/ 308

handle_path /signs/* {
    basic_auth {
        owner REPLACE_WITH_BCRYPT_HASH
    }
    request_body {
        max_size 30MB
    }
    reverse_proxy 127.0.0.1:18880 {
        header_up -Authorization
    }
}
