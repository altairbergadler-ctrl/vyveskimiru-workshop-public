# Lowercase public DNS name, no protocol, slash or port. A/AAAA must point to VPS.
DOMAIN=signs.example.com
ACME_EMAIL=you@example.com
EDITOR_USER=owner
# Generate interactively: docker run --rm -it caddy:2.11.7-alpine caddy hash-password
# Keep single quotes around the hash: Compose must not expand its dollar signs.
EDITOR_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'

APP_VERSION=vps-1
# Match the CLI version already used by the local integration. No automatic upgrade.
CODEX_VERSION=0.162.0-alpha.2

# Only for compose.host-proxy.yaml + compose.password.yaml (one-field app login):
# EDITOR_AUTH_HOST_FILE=/opt/signage-editor/private/editor-auth.json
