# Generated automatically by scripts/setup.sh. Keep the real .env private.
APP_USERNAME=admin
AUTH_MODE=password
# On vm-app.ru use AUTH_MODE=workshop and compose.workshop.yaml.
# The Workshop owner cookie is checked through this fixed internal endpoint.
WORKSHOP_AUTH_URL=http://finance-pwa:3000/api/session
APP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
HOST_PORT=8187
DATA_DIR=/data
SESSION_TTL_SECONDS=28800
JOB_TTL_SECONDS=0
MAX_UPLOAD_MB=25
MAX_PAGES=50
MAX_JOBS=100
MAX_TOTAL_MB=500
MAX_RESULT_MB=100
# Use false for http://localhost through an SSH tunnel, true behind HTTPS.
COOKIE_SECURE=false
# Empty for a standalone site; /tools/stamp for integration into vm-app.
APP_BASE_PATH=
