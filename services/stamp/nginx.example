# SNIPPET: add inside the existing vm-app HTTPS server block.
# Do not replace the existing server, TLS settings, or unrelated locations.
# App .env: APP_BASE_PATH=/tools/stamp and COOKIE_SECURE=true.
location = /tools/stamp {
    return 308 /tools/stamp/;
}

location ^~ /tools/stamp/ {
    client_max_body_size 30m;
    # The trailing slash strips /tools/stamp/ from the upstream request URI.
    proxy_pass http://127.0.0.1:8187/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_connect_timeout 5s;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
}

# Assumes nginx on the HOST. For containerized nginx, inspect network first.
# Test the complete configuration with nginx -t before its normal reload.
