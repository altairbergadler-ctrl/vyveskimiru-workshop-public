{
  "name": "finance-pwa",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "analytics:concepts": "node qa/analytics-concepts-preview.mjs",
    "analytics:concepts:qa": "node qa/analytics-concepts-browser.mjs",
    "analytics:hybrid:qa": "node qa/analytics-hybrid-browser.mjs",
    "analytics:simple:qa": "node qa/analytics-simple-browser.mjs",
    "analytics:performance:qa": "node qa/analytics-performance-browser.mjs",
    "analytics:real:qa": "node qa/analytics-real-browser.mjs",
    "build": "vite build",
    "diagnose": "node server/diagnose-live.mjs",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 server/*.test.mjs modules/orders/server/*.test.mjs qa/*.test.mjs",
    "lint": "node qa/lint.mjs",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && npm run lint && npm run build",
    "sandbox:start": "node qa/sandbox.mjs start",
    "sandbox:reset": "node qa/sandbox.mjs reset",
    "sandbox:stop": "node qa/sandbox.mjs stop",
    "production:preview": "node qa/production-preview.mjs start",
    "production:stop": "node qa/production-preview.mjs stop",
    "test:integration": "node qa/integration.mjs",
    "release:pack": "node qa/package-release.mjs",
    "setup": "node qa/setup.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "fflate": "0.8.3",
    "htmlparser2": "10.1.0",
    "imapflow": "2.0.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "mailparser": "3.9.23",
    "pdfkit": "0.20.2",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "pdfjs-dist": "6.4.299",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "type": "module",
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
