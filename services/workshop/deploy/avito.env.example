# Personal owner account. Default is off; startup never contacts Avito.
# Merge these settings into the existing private shared/app.env during activation.
AVITO_ENABLED=false
# Existing /data mount; no secret values in this environment template.
# On VPS: shared/data/private/avito.json, owner uid 1000, mode 0600.
AVITO_CREDENTIALS_FILE=/data/private/avito.json
# Optional expected account ID. After identity verification, pin this value.
AVITO_ACCOUNT_ID=

# Current month refresh every 6 hours; past periods are loaded manually.
AVITO_AUTO_IMPORT=false
