# Server-side Mail.ru reader. Enable only after the key and agent schedule are ready.
MAIL_IMPORT_ENABLED=false
MAIL_IMAP_USER=mailbox1@example.invalid
MAIL_DESIGNER_SENDER=mailbox2@example.invalid
MAIL_IMAP_FOLDER=INBOX
# Mount a private file containing the application password. Never commit the file.
MAIL_IMAP_PASSWORD_FILE=/run/secrets/workshop/mail-imap-password
# Initial backfill boundary only; existing cursor and subsequent new mail take precedence.
MAIL_IMAP_SINCE=2026-08-01
# Set desktop only after creating the matching thread automation (15 minutes).
MAIL_ASSISTANT_MODE=none
