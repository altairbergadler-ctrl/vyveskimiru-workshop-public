<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/widget_header"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/today_title"
            android:textColor="@color/ivory"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/today_subtitle"
            android:textColor="@color/forest_muted"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/today_orders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_row"
        android:contentDescription="@string/today_orders_description"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_orders"
        android:drawableTint="@color/ink"
        android:fontFamily="serif"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/today_orders"
        android:textColor="@color/ink"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/today_production"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_row"
        android:contentDescription="@string/today_production_description"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_production"
        android:drawableTint="@color/ink"
        android:fontFamily="serif"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/today_production"
        android:textColor="@color/ink"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/today_warehouse"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_row_bottom"
        android:contentDescription="@string/today_warehouse_description"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_warehouse"
        android:drawableTint="@color/ink"
        android:fontFamily="serif"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/today_warehouse"
        android:textColor="@color/ink"
        android:textSize="14sp" />
</LinearLayout>
