<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:padding="4dp">
    <TextView
        android:id="@+id/pulse_header"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:fontFamily="serif"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/pulse_title"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_below="@id/pulse_header"
        android:orientation="horizontal"
        android:weightSum="4">
        <TextView
            android:id="@+id/pulse_finance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_production"
            android:contentDescription="@string/pulse_finance_description"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_dashboard"
            android:drawableTint="@color/ivory"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/pulse_finance"
            android:textColor="@color/ivory"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/pulse_orders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_income"
            android:contentDescription="@string/pulse_orders_description"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_orders"
            android:drawableTint="@color/ink"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/pulse_orders"
            android:textColor="@color/ink"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/pulse_clients"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_expense"
            android:contentDescription="@string/pulse_clients_description"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_clients"
            android:drawableTint="@color/ink"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/pulse_clients"
            android:textColor="@color/ink"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/pulse_warehouse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_warehouse"
            android:contentDescription="@string/pulse_warehouse_description"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_warehouse"
            android:drawableTint="@color/ink"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/pulse_warehouse"
            android:textColor="@color/ink"
            android:textSize="11sp" />
    </LinearLayout>
</RelativeLayout>
