<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:orientation="vertical"
    android:padding="3dp"
    android:weightSum="2">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="2"
        tools:ignore="NestedWeights">
        <TextView
            android:id="@+id/action_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_expense"
            android:contentDescription="@string/expense_description"
            android:drawablePadding="3dp"
            android:drawableTop="@drawable/ic_expense"
            android:drawableTint="@color/ink"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/expense"
            android:textColor="@color/ink"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/action_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_income"
            android:contentDescription="@string/income_description"
            android:drawablePadding="3dp"
            android:drawableTop="@drawable/ic_income"
            android:drawableTint="@color/ink"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/income"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="2"
        tools:ignore="NestedWeights">
        <TextView
            android:id="@+id/action_production"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_production"
            android:contentDescription="@string/production_description"
            android:drawablePadding="3dp"
            android:drawableTop="@drawable/ic_production"
            android:drawableTint="@color/ivory"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/production"
            android:textColor="@color/ivory"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/action_warehouse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_warehouse"
            android:contentDescription="@string/warehouse_description"
            android:drawablePadding="3dp"
            android:drawableTop="@drawable/ic_warehouse"
            android:drawableTint="@color/ink"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/warehouse"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
